# ---- Scoring Heroes API settings. Copy this file to ".env" and fill it in. Never share or commit .env ----
PORT=8080

# Where the Scoring Heroes web app is hosted (HTTPS). The SMS link opens this address.
APP_URL=https://app.your-domain.com
# Only these web addresses may call the API (comma separated). Leave empty only while testing.
ALLOWED_ORIGINS=https://app.your-domain.com

# SMS gateway: console (prints OTP in the server log, for testing) or msg91
SMS_PROVIDER=console
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SHORT_URL=1
COUNTRY_CODE=91

# Live cricket data (CricketData.org / CricAPI). Key stays on the server, never in the app.
CRIC_API_KEY=paste-your-cricketdata-key-here
# Seconds to cache live data so many users do not use up your daily hits
LIVE_CACHE_SECONDS=60

# Roles. The first person who registers becomes admin. Others are viewers unless listed here.
ADMIN_PHONES=
SCORER_PHONES=

# Any long random text. Needed so logins survive a server restart.
SESSION_SECRET=change-this-to-a-long-random-text

# ---- Verify by SENDING an SMS to your number (inbound SMS) ----
# The number users send the SMS to (virtual/long number bought from your gateway). Empty = feature off.
MO_NUMBER=
MO_KEYWORD=SH
# Add this to the end of the inbound webhook URL you give the gateway: ...?key=THIS_VALUE
WEBHOOK_SECRET=change-me

# ---- Sports news for the Reels page ----
NEWS_QUERY=cricket

# WhatsApp login (optional, no SMS/DLT needed). Meta WhatsApp Cloud API webhook URL: https://YOUR-SERVER/api/wa/webhook
WA_NUMBER=
WA_VERIFY_TOKEN=change-me-too

# Email OTP (no SMS needed). EMAIL_PROVIDER = console (test, prints code in logs) | brevo | smtp | resend
# brevo (works on Render free, HTTPS): create a free Brevo account, verify your sender email there, make an API key (v3), then
#   EMAIL_PROVIDER=brevo  BREVO_API_KEY=xkeysib-...  EMAIL_FROM=SH Sports <your verified email>
# Note: Render free web services block SMTP ports 25/465/587, so smtp does not work there unless the service is on a paid instance.
EMAIL_PROVIDER=console
EMAIL_FROM=SH Sports <yourname@gmail.com>
# smtp (Gmail: turn on 2-step verification, create an App Password, use it as SMTP_PASS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=
# resend (alternative): RESEND_API_KEY=

# TextBee phone/SIM gateway: real SMS pilot, credentials stay in Render Environment.
# Set SMS_PROVIDER=textbee and SMS_REGIONS=91 to enable the India test route.
# Free hosted tier: 50/day, 300/month, 1 device; sent/received both count.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Optional dual-SIM subscription ID, copied from the device's current SIM list.
TEXTBEE_SIM_SUBSCRIPTION_ID=
# Sender is the selected SIM phone number; SH Sports appears in the message body.

# Shared-network OTP burst limit. Per-number limits remain unchanged.
SMS_OTP_IP_HOURLY_LIMIT=100
# Trial SMS pack cap (e.g. 50). After this many sent OTPs the app tells users to use email. 0 = no cap.
SMS_TOTAL_BUDGET=0

# ---- 30-year history store (matches + player career totals) ----
# Source: Cricsheet-format ball-by-ball JSON zip. Default URL below; verify the file name and licence on cricsheet.org.
HISTORY_URL=https://cricsheet.org/downloads/all_json.zip
HISTORY_YEARS=30
# Import automatically on start when nothing is stored (useful on Render Free, whose disk is erased on every restart).
HISTORY_AUTOIMPORT=0
# Folder for the stored files. Use a Render persistent disk path (paid) to keep them across restarts.
HISTORY_DIR=./history-data

# Free-licence photo finder (Openverse, Creative Commons). Default is the public API; anonymous use has low rate limits.
OPENVERSE_BASE=https://api.openverse.org/v1

# Own newsroom agent (articles written by the app itself from match facts; no third-party headlines)
# ANTHROPIC_API_KEY=            # optional: Claude re-words each report (numbers are checked; invented numbers are rejected)
# NEWS_AI_MODEL=claude-haiku-5-5

# Optional: Sportmonks Cricket API (adds umpires, referee, player of the match, playing XI, fall of wickets, ball by ball).
# When set, it replaces CricketData for the live list and match pages. Leave empty to keep using CRIC_API_KEY.
SPORTMONKS_TOKEN=

# Finished matches: ball by ball, officials, XI, fall of wickets from Cricsheet (open data, ODC-By). On by default; set 0 to switch off.
RECENT_OPEN_DATA=1
