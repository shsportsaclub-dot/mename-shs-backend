# ---- Scoring Heroes API settings. Copy this file to ".env" and fill it in. Never share or commit .env ----
PORT=8080

# Where the Scoring Heroes web app is hosted (HTTPS). The SMS link opens this address.
APP_URL=https://app.your-domain.com
# Only these web addresses may call the API (comma separated). Leave empty only while testing.
ALLOWED_ORIGINS=https://app.your-domain.com

# SMS gateway: console (prints OTP in the server log, for testing) or msg91
SMS_PROVIDER=console
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SHORT_URL=1
COUNTRY_CODE=91

# Live cricket data (CricketData.org / CricAPI). Key stays on the server, never in the app.
CRIC_API_KEY=paste-your-cricketdata-key-here
# Seconds to cache live data so many users do not use up your daily hits
LIVE_CACHE_SECONDS=60

# Roles. The first person who registers becomes admin. Others are viewers unless listed here.
ADMIN_PHONES=
SCORER_PHONES=

# Any long random text. Needed so logins survive a server restart.
SESSION_SECRET=change-this-to-a-long-random-text

# ---- Verify by SENDING an SMS to your number (inbound SMS) ----
# The number users send the SMS to (virtual/long number bought from your gateway). Empty = feature off.
MO_NUMBER=
MO_KEYWORD=SH
# Add this to the end of the inbound webhook URL you give the gateway: ...?key=THIS_VALUE
WEBHOOK_SECRET=change-me

# ---- Sports news for the Reels page ----
NEWS_QUERY=cricket

# WhatsApp login (optional, no SMS/DLT needed). Meta WhatsApp Cloud API webhook URL: https://YOUR-SERVER/api/wa/webhook
WA_NUMBER=
WA_VERIFY_TOKEN=change-me-too
